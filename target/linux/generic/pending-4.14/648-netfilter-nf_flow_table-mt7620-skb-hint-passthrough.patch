diff --git a/net/netfilter/nf_flow_table_ip.c b/net/netfilter/nf_flow_table_ip.c
--- a/net/netfilter/nf_flow_table_ip.c
+++ b/net/netfilter/nf_flow_table_ip.c
@@ -225,7 +225,28 @@ nf_flow_offload_ip_hook(void *priv, struct sk_buff *skb,
 	struct iphdr *iph;
 	__be32 nexthop;
 
+#ifdef CONFIG_SOC_MT7620
+	/*
+	 * MT7620 Variant 2 (SDK-model): the PPE sends sample packets (CPU
+	 * reason 0x0f = HIT_UNBIND_RATE_REACHED / 0x0e = HIT_UNBIND) that
+	 * carry the FOE slot index in skb->cb, saved by the mediatek ethernet
+	 * driver on RX.  Let them pass through the software fast-path so that
+	 * the driver's netfilter POSTROUTING hook can bind the slot in
+	 * hardware (state=BIND).  Finishing the SW forward here would eat the
+	 * sample and the flow would never be offloaded.
+	 *
+	 * The hint sits at skb->cb offset 44 (past IPCB / bridge / GRO data)
+	 * and is matched inline - no cross-module dependency.
+	 */
+#define MTK_HNAT_CB_OFFSET	44
+#define MTK_HNAT_CB_MAGIC	0x4d544b48
+#define MTK_HNAT_CB_MASK	0xfffff000
+	if ((*(u32 *)&skb->cb[MTK_HNAT_CB_OFFSET] & MTK_HNAT_CB_MASK) ==
+	    MTK_HNAT_CB_MAGIC)
+		return NF_ACCEPT;
+#endif
+
 	if (skb->protocol != htons(ETH_P_IP))
 		return NF_ACCEPT;
 
 	if (nf_flow_tuple_ip(skb, state->in, &tuple) < 0)
