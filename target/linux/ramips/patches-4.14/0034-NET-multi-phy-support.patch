diff --git a/drivers/net/phy/phy.c b/drivers/net/phy/phy.c
index e5b86f07..ffc7c416 100644
--- a/drivers/net/phy/phy.c
+++ b/drivers/net/phy/phy.c
@@ -914,7 +914,10 @@ void phy_state_machine(struct work_struct *work)
 		/* If the link is down, give up on negotiation for now */
 		if (!phydev->link) {
 			phydev->state = PHY_NOLINK;
-			phy_link_down(phydev, true);
+			if (!phydev->no_auto_carrier_off)
+				phy_link_down(phydev, true);
+			else
+				phy_link_down(phydev, false);
 			break;
 		}
 
@@ -1001,7 +1004,10 @@ void phy_state_machine(struct work_struct *work)
 			phy_link_up(phydev);
 		} else {
 			phydev->state = PHY_NOLINK;
-			phy_link_down(phydev, true);
+			if (!phydev->no_auto_carrier_off)
+				phy_link_down(phydev, true);
+			else
+				phy_link_down(phydev, false);
 		}
 
 		if (phy_interrupt_is_valid(phydev))
@@ -1011,7 +1017,10 @@ void phy_state_machine(struct work_struct *work)
 	case PHY_HALTED:
 		if (phydev->link) {
 			phydev->link = 0;
-			phy_link_down(phydev, true);
+			if (!phydev->no_auto_carrier_off)
+				phy_link_down(phydev, true);
+			else
+				phy_link_down(phydev, false);
 			do_suspend = true;
 		}
 		break;
